# Copy to .env and fill in values
# cp .env.example .env

# Data source (nrel or synthetic)
DATA_SOURCE=synthetic

# NREL PVDAQ API key — get free at https://developer.nrel.gov/signup/
NREL_API_KEY=DEMO_KEY

# System ID to pull from PVDAQ (default is a well-documented 5kW residential system)
PVDAQ_SYSTEM_ID=2

# Model settings
ANOMALY_THRESHOLD_SIGMA=2.0
TRAIN_TEST_SPLIT_DATE=2023-01-01

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of allowed frontend origins
# Use "*" to allow all (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000

# Artifact paths (relative to repo root)
MODEL_DIR=artifacts/models
DATA_PROCESSED_DIR=data/processed
