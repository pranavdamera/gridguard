# GridGuard backend configuration.
#
#   cp .env.example .env
#
# Every value below has a working default — GridGuard runs with no .env at all.
# Nothing here is a secret in the shipped configuration: the real-data pipeline
# reads a public dataset over anonymous HTTPS and needs no credentials.

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------

# Which fleet the API serves by default: "real" (measured PVDAQ telemetry) or
# "synthetic" (the simulated DMV demonstration fleet). Both are always available
# per-site; this only sets the default view.
DATA_MODE=synthetic

# Curated measured-data window. Only used when regenerating data/curated/ with
# `make data-real` — the curated parquet files are committed, so a fresh clone
# never downloads anything.
REAL_DATA_START=2016-01-01
REAL_DATA_END=2016-12-31

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# No external service needs one. Every PV system GridGuard ships with publishes
# irradiance, temperature and wind measured at the array, and the OEDI data lake
# serves them over anonymous HTTPS. No key, token or account is required to run
# the demo, the pipeline, or the web application.
#
# The live-ingestion profile (`docker compose --profile live up`) runs a local
# Postgres. This is the password compose defaults to — a documented dummy for a
# container on a private compose network with no published port, not a secret.
# Override it here, or in your own environment, for anything beyond a local demo.
#
# POSTGRES_PASSWORD=gridguard

# ---------------------------------------------------------------------------
# Live ingestion (optional — only the `live` compose profile uses these)
# ---------------------------------------------------------------------------
# GRIDGUARD_MQTT_HOST=localhost
# GRIDGUARD_MQTT_PORT=1883
#
# Postgres DSN for the collector. Unset falls back to a local SQLite file, which
# is fine for one process and wrong for two — the collector and the API are
# separate containers, and SQLite over a shared volume loses writes.
# GRIDGUARD_STORE_DSN=postgresql://gridguard:gridguard@localhost:5432/gridguard

# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------

# "conformal" (default, calibrated coverage guarantee) or "sigma" (legacy
# benchmark, retained for comparison).
ANOMALY_METHOD=conformal

# Conformal miscoverage level. 0.05 targets a 95% one-sided interval: at most
# ~5% of healthy intervals should fall below the bound.
CONFORMAL_ALPHA=0.05

# Legacy sigma-detector threshold, used only when ANOMALY_METHOD=sigma.
ANOMALY_THRESHOLD_SIGMA=2.0

# ---------------------------------------------------------------------------
# Modelling
# ---------------------------------------------------------------------------

# Temporal train/test split. Everything from this date onward is held out.
TRAIN_TEST_SPLIT_DATE=2016-10-01
REAL_TRAIN_TEST_SPLIT_DATE=2016-10-01

# Radius within which sites are treated as weather neighbours.
NEIGHBOR_RADIUS_KM=60

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API.
# Set this to your deployed frontend origin in production. "*" is accepted but
# logs a warning — do not ship it.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allow Vercel preview deployments (https://<branch>-<project>.vercel.app).
# Off by default: it widens the allowed set to any *.vercel.app host.
CORS_ALLOW_VERCEL_PREVIEWS=false

# ---------------------------------------------------------------------------
# Paths (relative to repo root)
# ---------------------------------------------------------------------------

MODEL_DIR=artifacts/models
REPORT_DIR=artifacts/reports
DATA_PROCESSED_DIR=data/processed
DATA_CURATED_DIR=data/curated
