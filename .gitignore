# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/
env/

# Data
# data/curated/ IS version-controlled: small curated measured datasets so a
# fresh clone can run the real-data pipeline with no download. Everything else
# is a cache or a derived product and is regenerated by `make build-artifacts`.
/data/raw/
/data/processed/
/data/synthetic/

# Model artifacts — rebuilt by `make build-artifacts`, far too large for git.
#
# Leading slash matters: an unanchored `artifacts/` also matches
# src/gridguard/artifacts/, which silently excluded that source package from
# the repository. It worked locally (the files were on disk) and failed in CI
# with ModuleNotFoundError. Keep these paths anchored to the repo root.
/artifacts/

# Env / secrets — never commit these
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Ruff cache
.ruff_cache/

# Next.js frontend
web/node_modules/
web/.next/
web/.env.local
web/out/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
