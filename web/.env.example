# GridGuard frontend configuration.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so
# never put a secret here. This file holds one value: where the API lives.

# URL of the GridGuard API.
#   Local:  http://localhost:8000
#   Render: https://your-service.onrender.com
#
# On Vercel, set this in Project Settings -> Environment Variables. It must be
# set at *build* time, not just runtime, and changing it requires a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000
